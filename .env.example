# 课件讲解平台 — 环境变量示例
# 复制成 .env 后按需修改；也可以用 `export XXX=...` 直接设置。
# 注意：本项目不会自动读取 .env，请用 `set -a; source .env; set +a` 或写进启动脚本。

# ---------- 运行模式 ----------
# 1 = 公开部署：访客必须自带 API Key，服务器不使用也不保存自己的 Key
# 0 = 本机模式：用服务器自己的 Key，开箱即用
# 不设置时：HOST 不是 127.0.0.1 就自动按公开模式运行（安全兜底）
PUBLIC_MODE=1

# 监听地址与端口。公开部署通常用 0.0.0.0（再套 Nginx/Caddy 做 HTTPS）
HOST=0.0.0.0
PORT=4173

# 在反向代理后面时开启，让日志和限流拿到真实 IP
# TRUST_PROXY=1

# 站点名称（显示在浏览器标题栏）
SITE_NAME=课件讲解平台

# ---------- 本机模式下的 API Key（公开模式会被忽略） ----------
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 资源限制（公开部署建议开启） ----------
MAX_PROJECTS_PER_SESSION=30      # 每个会话最多几个项目
MAX_STORAGE_MB=500               # 每个会话上传总量上限
RATE_ANALYZE_PER_HOUR=20         # 每小时最多几次完整分析
RATE_GRADE_PER_HOUR=400          # 每小时最多几次批改/问答
RATE_UPLOAD_PER_HOUR=80          # 每小时最多几次上传

# ---------- 自动清理 ----------
CLEANUP_TTL_DAYS=14              # 多少天没动过的项目会被删掉
AUTO_CLEANUP=0                   # 设为 0 关闭自动清理（磁盘会一直涨）

# ---------- 上下文预算 ----------
MAX_INPUT_CHARS=90000            # 发给模型的课件文字上限

# ---------- 读图：用哪个视觉模型 ----------
# 带图的调用会自动切到这个模型；纯文字调用仍用 DEEPSEEK_MODEL。
# 注意 deepseek-v4-pro 不认图片（会回「[Unsupported Image]」），实测能读图的是 deepseek-flash。
# VISION_MODEL=deepseek-flash

# ---------- 读图：哪些页需要看，以及单次请求装多少 ----------
# 平台的默认行为是「自动」：先用 PDF 绘图指令算出每页的位图覆盖面积和矢量线段数，
# 只把图表页渲染成图片发给视觉模型，纯文字页只送文字。
# 下面两个阈值就是当初拿 460 页真实课件量出来的，一般不用改。
# PAGE_IMG_RATIO_MIN=0.15         # 位图覆盖整页的比例超过它就算图表页（整页扫描件 ≈1.0，页眉 logo 只占百分之几）
# PAGE_PATH_SEGS_MIN=60           # 矢量线段数超过它也算（表格框线、流程图、电路图）

# 单次请求最多带多少图。不同接口的请求体上限差得很远（实测 api.deepseek.com 是 50MB 才拒，
# 不少中转网关只有几百 KB），所以平台默认只带 16MB、最多 80 页，超了就按整份材料均匀取样。
# 真被网关拒了（413）会自动一路退让到只发文字，并把这家接口的上限记下来。
# AI_IMAGE_BUDGET_MB=16           # 单次请求图片总预算（MB）
# AI_MAX_IMAGES=80                # 单次请求图片张数上限

# 渲染页面的画质。默认会按页数自适应（≤24 页 1100px、≤60 页 900px、更多 760px），
# 改这里会覆盖成固定值。（实测单页 1100/0.82 = 62KB、900/0.74 = 42KB、760/0.66 = 31KB）
# PAGE_IMAGE_WIDTH=1100
# PAGE_IMAGE_QUALITY=0.82

# 页面渲染依赖本机的 Chrome / Chromium / Edge。装在非常规位置时用这个指过去。
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ---------- 删除行为 ----------
# 默认是「软删除」：项目删掉后移到 data/trash/，30 天内还能捞回来。
# CW_HARD_DELETE=1              # 设成 1 才是真的直接删除，不进回收站

# ---------- 更新检查（可选，默认关闭 = 不联网）----------
# 自建部署默认只看本机磁盘上的 version.json，不会知道 GitHub 上有没有新版。
# 填上仓库里 version.json 的 raw 地址，右上角版本号就会在远端有新版本时变红。
# 也可以改 data/config.json 的 updateCheckUrl，或在界面里点版本号填。
# UPDATE_CHECK_URL=https://raw.githubusercontent.com/<用户名>/<仓库>/main/version.json
# UPDATE_CHECK_TTL_MS=1800000       # 多久去拉一次远端清单，默认 30 分钟

# ---------- 上课录像转写（STT）----------
# 优先级：本地 whisper.cpp → 讯飞 → Groq → OpenAI。服务器会自动探测，一般不用配。
# 想强制指定其中一种：
# STT_PROVIDER=local              # local | xfyun | groq | openai

# 本地 whisper.cpp（最推荐：免费、不联网、不限时长、不吃任何额度）
# brew install whisper-cpp ffmpeg
# 模型下载：https://hf-mirror.com/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
# WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL=/Users/you/.cache/whisper-models/ggml-large-v3-turbo.bin
# WHISPER_LANG=auto               # auto | zh | en

# 讯飞「录音文件转写」——要在 http://www.xfyun.cn/services/lfasr 领免费额度，
# 否则会报 26625（凭据正确但账上没时长）。也可以写进 data/config.json。
# XFYUN_APP_ID=
# XFYUN_API_KEY=
# XFYUN_API_SECRET=
# XFYUN_SECRET_KEY=             # XFYUN_API_SECRET 的别名，写哪个都行

# Groq Whisper（免费额度，OpenAI 兼容协议；不需要本地装任何东西）
# 申请：https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_STT_MODEL=whisper-large-v3-turbo

# OpenAI Whisper（备选，$0.006/分钟，单文件上限 25MB）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_STT_MODEL=whisper-1
